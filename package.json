{
  "name": "calendar-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:lib": "pnpm --filter @savvycal/calendar dev",
    "build": "pnpm --filter @savvycal/calendar build && pnpm --filter playground build",
    "build:lib": "pnpm --filter @savvycal/calendar build",
    "typecheck": "pnpm --filter @savvycal/calendar typecheck && pnpm --filter @savvycal/calendar build && pnpm --filter playground typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:md": "prettier --write \"**/*.md\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:lib && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
